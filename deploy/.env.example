# Deployment secrets and variables. Copy to `.env` (gitignored), then fill in.
# Application flags (download.enabled, port_sync.enabled) live in
# config/crawler/crawler.yml, NOT here.

# --- Required ---
# A password YOU choose. No `change-me` must remain.
AMULE_EC_PASSWORD=change-me            # crawler <-> amuled, at least 12 characters

# --- Optional ---
IMAGE_TAG=latest                       # GHCR image tag
WEBUI_PORT=8080                        # catalog: http://localhost:8080

# --- VPN stack (gluetun.compose.yml) only ---
WIREGUARD_PRIVATE_KEY=change-me        # from the VPN provider's client area
VPN_SERVICE_PROVIDER=protonvpn
SERVER_COUNTRIES=                      # e.g. Switzerland,France (English names)
VPN_PORT_FORWARDING=off                # on => High-ID (+ port_sync.enabled: true)

# --- High-ID without VPN (default stack) ---
LISTEN_PORT=4662                       # port forwarded on the router (TCP+UDP)
