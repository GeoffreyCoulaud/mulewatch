# Deployment secrets and variables. Copy to `.env` (gitignored), then fill in.
# Application flags (download.enabled, port_sync.enabled) live in crawler.yml, NOT here.

# --- Required ---
# Passwords YOU choose. No `change-me` must remain. The container refuses to start without them.
AMULE_EC_PASSWORD=change-me            # crawler <-> amuled, at least 12 characters
# WEBUI_PWD protects PORT 4711 ONLY (amuleweb, aMule's own web UI).
# PORT 8080 HAS NO AUTHENTICATION AT ALL. It serves the catalog, the crawl controls and a
# read-only SQL console to anyone who can reach it. Put it behind a reverse proxy or a VPN.
WEBUI_PWD=change-me                    # amuleweb admin password (port 4711)

# The uid/gid the container's `amule` user takes. Set them to YOUR user (`id -u` / `id -g`):
# they are what keeps deploy/data/, deploy/amule/ and deploy/downloads/ readable without sudo,
# so `sqlite3 deploy/data/catalog.db` just works.
PUID=1000
PGID=1000

# --- Optional ---
IMAGE_TAG=latest                       # GHCR image tag
WEBUI_PORT=8080                        # catalog, NO AUTH: http://localhost:8080
AMULEWEB_PORT=4711                     # aMule web UI, WEBUI_PWD: http://localhost:4711

# --- VPN stack (gluetun.compose.yml) only ---
WIREGUARD_PRIVATE_KEY=change-me        # from the VPN provider's client area
VPN_SERVICE_PROVIDER=protonvpn
SERVER_COUNTRIES=                      # e.g. Switzerland,France (English names)
VPN_PORT_FORWARDING=off                # on => High-ID (+ port_sync.enabled: true)

# --- High-ID without VPN (default stack) ---
LISTEN_PORT=4662                       # port forwarded on the router (TCP+UDP)
