#!/bin/sh
exec 2>&1
# -u, but deliberately NOT -e: an unset PUID would otherwise make the chown below a silent no-op
# and hand the crawler a root-owned /data, while -e would turn the s6-svperms failure this script
# explicitly tolerates into a non-zero exit, which `finish` escalates into killing the container.
set -u

# s6-svperms needs amuled's supervise directory, which s6-supervise only creates once it has
# started amuled — and all three services start at the same time. Bounded wait: without the group
# permission we lose the ability to restart amuled for a port change, not the crawl itself.
control=/etc/services.d/amuled/supervise/control
attempt=0
while [ ! -e "$control" ] && [ "$attempt" -lt 100 ]; do
	attempt=$((attempt + 1))
	sleep 0.1
done
if [ -e "$control" ]; then
	s6-svperms -G amule /etc/services.d/amuled
else
	echo "mulewatch: $control never appeared; amuled restarts will be refused" >&2
fi

mkdir -p /data
chown -R "$PUID:$PGID" /data

# Explicit paths: the CLI defaults are relative to a repo checkout.
exec setpriv --reuid amule --regid amule --init-groups \
	env HOME=/home/amule python -m mulewatch \
		--config /app/config/crawler.yml \
		--targets /app/config/targets.yml \
		--matcher /app/config/matcher.yml
